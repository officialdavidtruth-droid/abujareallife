generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum JobStatus {
  ACTIVE
  INACTIVE
}

enum PropertyType {
  ROOM
  APARTMENT
  HOUSE
  MANSION
}

enum VehicleType {
  CAR
  SUV
  MOTORCYCLE
  BUS
}

enum MissionStatus {
  AVAILABLE
  ACTIVE
  COMPLETED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  usernameKey  String     @unique
  passwordHash String
  email        String?    @unique
  emailVerifiedAt DateTime?
  origin       String?   // 'LAPO' | 'NEPO': spun once at sign-up, never changes
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  character    Character?
  transactions Transaction[]
  inventory    InventoryItem[]
  properties   Property[]
  vehicles     Vehicle[]
  missions     PlayerMission[]
  codes        EmailCode[]
  save         Save?
  management   Management?
  businesses   PlayerBusiness[]
  careers      CareerProgress[]
  reputation   Reputation?
  position     PlayerPosition?
  driver       DriverProfile?
}

model Character {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  gender      Gender   @default(OTHER)
  age         Int      @default(24)
  level       Int      @default(1)
  xp          Int      @default(0)
  cash        Int      @default(50000)
  bankBalance Int      @default(0)
  health      Int      @default(100)
  energy      Int      @default(100)
  hunger      Int      @default(100)
  mood        Int      @default(75)
  fitness     Int      @default(50)
  district    String   @default("Wuse")
  appearance  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

model Job {
  id          String     @id @default(cuid())
  title       String     @unique
  company     String
  district    String
  salary      Int
  energyCost  Int        @default(15)
  xpReward    Int        @default(50)
  status      JobStatus  @default(ACTIVE)
  characters  Character[]
}

model Property {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  district    String
  type        PropertyType
  price       Int
  rent        Int            @default(0)
  purchasedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([district])
}

model Vehicle {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        VehicleType
  price       Int
  fuel        Int         @default(100)
  condition   Int         @default(100)
  mileage     Int         @default(0)
  insured     Boolean     @default(false)
  registered  Boolean     @default(false)
  parkedAt    String?
  paint       String    @default("factory")
  rims        String    @default("factory")
  tint        Int       @default(0)
  stolen      Boolean   @default(false)
  purchasedAt DateTime    @default(now())
  createdAt   DateTime    @default(now())

  @@index([userId])
}

model InventoryItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKey   String
  name      String
  quantity  Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemKey])
}

model Mission {
  id          String          @id @default(cuid())
  key         String          @unique
  title       String
  description String
  rewardCash  Int             @default(0)
  rewardXp    Int             @default(0)
  createdAt   DateTime        @default(now())
  players     PlayerMission[]
}

model PlayerMission {
  id          String        @id @default(cuid())
  userId      String
  missionId   String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission     Mission       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  status      MissionStatus @default(AVAILABLE)
  progress    Int           @default(0)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, missionId])
  @@index([userId, status])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  amount      Int
  description String
  balanceType String   @default("CASH")
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  look      Json
  state     Json
  cash      Int      @default(1000000)
  profile   Json?
  heat      Int      @default(0)
  heatAt    DateTime?
  jailUntil DateTime?
  questId   String?
  questAt   DateTime?
  inside    String?
  insideAt  DateTime?
  jobAct    String?
  jobAt     DateTime?
  origin    String?              // 'LAPO' | 'NEPO' (decided by the server-side wheel spin)
  hasCar    Boolean  @default(false)
  fame      Int      @default(0)
  fameCarry Int      @default(0) // active seconds not yet converted to fame
  fameAt    DateTime?
  fameDay   String?
  fameToday Int      @default(0)
  mgrTasks  Int      @default(0) // management tasks completed toward the next manager appointment
  freeWill  Boolean  @default(true) // character acts on its own (and keeps working while the browser is closed)
  workBiz   String?              // workplace: the business of the last shift you started
  workJob   Int?                 // index into that business's shift jobs
  seenAt    DateTime?            // last heartbeat from the open game (gap = time away)
  drunk     Int      @default(0) // 0-100 alcohol level (server-owned, fades over time)
  high      Int      @default(0) // 0-100 weed level (server-owned, fades over time)
  intoxAt   DateTime?            // when drunk/high were last decayed
  updatedAt DateTime @updatedAt

  @@index([fame])
}

model Invite {
  id        String   @id @default(cuid())
  fromId    String
  toName    String
  building  String
  createdAt DateTime @default(now())
  @@unique([toName, building])
}

model Relationship {
  id        String   @id @default(cuid())
  aName     String
  bName     String
  status    String
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([aName, bName])
}

model Crime {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  caught    Boolean  @default(false)
  loot      Int      @default(0)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

// One manager seat per business. Unique businessId = the first applicant wins; unique userId = one seat per player. Expired rows count as vacant.
model Management {
  id         String    @id @default(cuid())
  businessId String    @unique
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  since      DateTime  @default(now())
  expiresAt  DateTime
  lastPaidAt DateTime?

  @@index([expiresAt])
}

// Player-to-player marketplace. Items are held in escrow (taken out of the seller's inventory) while a listing is ACTIVE.
model Listing {
  id         String   @id @default(cuid())
  sellerId   String
  sellerName String
  itemKey    String
  qty        Int      // units still for sale
  price      Int      // per unit, in naira
  soldQty    Int      @default(0)
  earned     Int      @default(0) // naira the seller received after the market fee
  status     String   @default("ACTIVE") // ACTIVE | SOLD | CANCELLED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([sellerId, status])
}

// Phone messages between players (one row per message; a "thread" is every row between two names).
model Message {
  id        String    @id @default(cuid())
  fromId    String
  fromName  String
  toName    String
  kind      String    @default("text") // text | loc | cash
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([toName, readAt])
  @@index([fromName, createdAt])
  @@index([toName, createdAt])
}


model PlayerBusiness {
  id          String   @id @default(cuid())
  userId      String
  businessId  String   @unique
  name        String
  type        String
  district    String
  level       Int      @default(1)
  reputation  Int      @default(50)
  revenue     Int      @default(0)
  expenses    Int      @default(0)
  balance     Int      @default(0)
  staff       Int      @default(0)
  menu        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([district, type])
}

model CareerProgress {
  id          String   @id @default(cuid())
  userId      String
  profession  String
  title       String
  rank        Int      @default(1)
  xp          Int      @default(0)
  completed   Int      @default(0)
  salaryBonus Int      @default(0)
  unlockedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, profession])
}

model Reputation {
  id        String   @id @default(cuid())
  userId    String   @unique
  score     Int      @default(50)
  trust     Int      @default(50)
  crime    Int      @default(0)
  social    Int      @default(50)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CityEvent {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String
  district    String
  kind        String
  intensity   Int      @default(1)
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  data        Json?
  createdAt   DateTime @default(now())
  @@index([active, startsAt, endsAt])
  @@index([district, active])
}

model CityBusinessMetric {
  id          String   @id @default(cuid())
  businessId  String
  dayKey      String
  visitors    Int      @default(0)
  revenue     Int      @default(0)
  incidents   Int      @default(0)
  rating      Int      @default(50)
  updatedAt   DateTime @updatedAt
  @@unique([businessId, dayKey])
}


model PlayerPosition {
  id        String   @id
  userId    String   @unique
  username  String   @unique
  x         Float    @default(0)
  z         Float    @default(0)
  r         Float    @default(0)
  district  String   @default("Wuse")
  driving   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([district, updatedAt])
}

model DriverProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  active      Boolean  @default(false)
  vehicleType String   @default("taxi")
  baseFare    Int      @default(1500)
  perKm       Int      @default(450)
  rating      Int      @default(50)
  trips       Int      @default(0)
  earnings    Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A ride one player orders for another. The rider must accept; the sender is charged only on acceptance.
// status: pending -> accepted -> riding -> completed   (or declined / cancelled / expired)
model RideRequest {
  id         String   @id @default(cuid())
  fromUserId String
  fromName   String
  toUserId   String
  toName     String
  kind       String   @default("taxi")
  destName   String
  destX      Float
  destZ      Float
  fare       Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

// Club underworld deals between two real players (lib/nightlife.ts). status: pending | accepted | declined | expired
model Deal {
  id        String   @id @default(cuid())
  building  String
  kind      String
  price     Int
  fromId    String
  fromName  String
  toId      String
  toName    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  @@index([toId, status])
  @@index([fromId, status])
}
