# PostgreSQL connection string for Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/abuja_real_life?schema=public"

# REQUIRED: random secret (32+ chars) used to sign login cookies. Generate: openssl rand -base64 48
AUTH_SECRET=""

# OPTIONAL: real email delivery for verification codes (https://resend.com).
# Without these, codes are only printed in the server log (fine for local testing).
RESEND_API_KEY=""
MAIL_FROM="Abuja Real Life <noreply@yourdomain.com>"

# Multiplayer (Supabase Realtime): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Voice calls on phone networks need a TURN relay. Set ONE of these (server-side, safe to keep private):
#  A) Metered.ca
METERED_DOMAIN=""
METERED_API_KEY=""
#  B) Cloudflare Calls TURN
CF_TURN_KEY_ID=""
CF_TURN_API_TOKEN=""
#  C) Any TURN server
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
